000025BA  4110 85E6                     000025E6   465          LA    R1,MSGCMD           Point to true command

000025BE  83120008                                 467          DC    X'83',X'12',X'0008' Issue Hercules Diagnose X'008'
000025C2  4780 85CE                     000025CE   468          BZ    MSGRET              Return if successful
                                                   469
000025C6  1222                                     470          LTR   R2,R2               Is Diag8 Ry (R2) 0?
000025C8  4780 85CE                     000025CE   471          BZ    MSGRET                an error occurred but coninue
                                                   472
000025CC  0000                                     473          DC    H'0'                CRASH for debugging purposes

000025CE  9802 85D4                     000025D4   475 MSGRET   LM    R0,R2,MSGSAVE       Restore registers
000025D2  07F2                                     476          BR    R2                  Return to caller






