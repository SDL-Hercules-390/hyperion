                                                  1423 * VPSOP - VECTOR PERFORM SIGN OPERATION DECIMAL
                                                  1424 *---------------------------------------------------------------------
                                                  1425 * VPSOP with some I3, I4 and M5's
                                                  1426 * I3 tests
                                                  1427 *                     i4=129 (iom=1, rdc=1)
                                                  1428 *                     i4=132 (iom=1, rdc=4)
                                                  1429 *                     i4=135 (iom=1, rdc=7)
                                                  1430 *                     i4=142 (iom=1, rdc=14)
                                                  1431 *                     i4=159 (iom=1, rdc=31)
                                                  1432 * I4 : so=00
                                                  1433 *        i4=128 (nv=1, nz=0, //, so=00, pc=0, sv=0)
                                                  1434 *        i4=130 (nv=1, nz=0, //, so=00, pc=1, sv=0)
                                                  1435 *
                                                  1436 *        i4=192 (nv=1, nz=1, //, so=00, pc=0, sv=0)
                                                  1437 *        i4=194 (nv=1, nz=1, //, so=00, pc=1, sv=0)
                                                  1438
                                                  1439 * I4 : so=01
                                                  1440 *        i4=132 (nv=1, nz=0, //, so=01, pc=0, sv=0)
                                                  1441 *        i4=134 (nv=1, nz=0, //, so=01, pc=1, sv=0)
                                                  1442 *
                                                  1443 *        i4=196 (nv=1, nz=1, //, so=01, pc=0, sv=0)
                                                  1444 *        i4=198 (nv=1, nz=1, //, so=01, pc=1, sv=0)
                                                  1445
                                                  1446
                                                  1447 * I4 : so=10
                                                  1448 *        i4=136 (nv=1, nz=0, //, so=10, pc=0, sv=0)
                                                  1449 *        i4=138 (nv=1, nz=0, //, so=10, pc=1, sv=0)
                                                  1450 *
                                                  1451 *        i4=200 (nv=1, nz=1, //, so=10, pc=0, sv=0)
                                                  1452 *        i4=202 (nv=1, nz=1, //, so=10, pc=1, sv=0)
                                                  1453
