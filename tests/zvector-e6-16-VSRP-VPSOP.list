                                                   614 ***********************************************************************
                                                   615 *     Macros to help build test tables
                                                   616 *----------------------------------------------------------------------
                                                   617 *     VRI_G Macro to help build test tables
                                                   618 ***********************************************************************
                                                   619          MACRO
                                                   620          VRI_G &INST,&I3,&I4,&M5,&CC
                                                   621 .*                               &INST  - VRI-g instruction under test
                                                   622 .*                               &i3    - i3 field
                                                   623 .*                               &i4    - i4 field
                                                   624 .*                               &m5    - m5 field
                                                   625 .*                               &CC    - expected CC
                                                   626 .*
                                                   627          LCLA  &XCC(4)  &CC has mask values for FAILED condition codes
                                                   628 &XCC(1)  SETA  7                 CC != 0
                                                   629 &XCC(2)  SETA  11                CC != 1
                                                   630 &XCC(3)  SETA  13                CC != 2
                                                   631 &XCC(4)  SETA  14                CC != 3
                                                   632 .*
                                                   633          GBLA  &TNUM
                                                   634 &TNUM    SETA  &TNUM+1
                                                   635
                                                   636          DS    0FD
                                                   637          USING *,R5              base for test data and test routine
                                                   638
                                                   639 T&TNUM   DC    A(X&TNUM)         address of test routine
                                                   640          DC    H'&TNUM'          test number
                                                   641          DC    X'00'
                                                   642          DC    HL1'&I3'          i3
                                                   643          DC    HL1'&I4'          i4
                                                   644          DC    HL1'&M5'          m5
                                                   645          DC    HL1'&CC'          cc
                                                   646          DC    HL1'&XCC(&CC+1)'  cc failed mask
                                                   647 V2_&TNUM DC    A(RE&TNUM+16)     address of v2: 16-byte packed decimal
                                                   648          DC    CL8'&INST'        instruction name
                                                   649
                                                   650 V1O&TNUM DC    XL16'00'          V1 OUTPUT
                                                   651 CC&TNUM  DC    2F'0'                after instruction PWS (ie CC)
                                                   652
                                                   653          DC    A(16)             result length
                                                   654 REA&TNUM DC    A(RE&TNUM)        result address
                                                   655 .*
                                                   656 *                                INSTRUCTION UNDER TEST ROUTINE
                                                   657
                                                   658 X&TNUM   DS    0F
                                                   659          LGF   R2,V2_&TNUM       get v2
                                                   660          VL    V2,0(R2)
                                                   661
                                                   662          &INST V1,V2,&I3,&I4,&M5  test instruction
                                                   663
                                                   664          VST   V1,V1O&TNUM       save result
                                                   665          EPSW  R2,R0             exptract psw
                                                   666          ST    R2,CC&TNUM             to save CC
                                                   667          BR    R11               return
                                                   668
                                                   669 RE&TNUM  DC    0F
