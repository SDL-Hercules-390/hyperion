*Testcase dfp-quantize.tst: QADTR, QAXTR (QUANTIZE DFP long and extended)
#
# QUANTIZE R1,R3,R2,M4: the result has the value of the second operand
# (R3) and the quantum (exponent) of the third operand (R2).
#
# The prologue at 200 enables the AFP-register control (CR0 bit 45) needed for DFP.
#
# Operands (DPD encoded), long and (as decimal128) extended:
#    A = 12345       B = 1E-2       C = 1E0       D = 1234500E-2
#
#    QADTR f1,f3,f2   f3 = A, f2 = B   ->  1234500E-2
#    QADTR f4,f3,f2   f3 = D, f2 = C   ->  12345E0
#    QAXTR f0,f8,f4   f8 = A, f4 = B   ->  1234500E-2
#    QAXTR f1,f8,f4   f8 = D, f4 = C   ->  12345E0
#
sysclear
archlvl z
r    1A0=00000001800000000000000000000200
r    1C0=00020001800000000000000000000000
r    1D0=00020001800000000000000000000000
r    200=EB000500002596040505EB000500002F
r    210=6820030868300300B3F5301260100400
r    220=6820031068300318B3F5304260400408
r    230=68400330686003386880032068A00328
r    240=B3FD8004600004106020041868400340
r    250=686003486880035068A00358B3FD8014
r    260=60100420603004280AFF
r    300=22380000000049C52230000000000001
r    310=2238000000000001223000000014D280
r    320=220800000000000000000000000049C5
r    330=22078000000000000000000000000001
r    340=22080000000000000000000000000001
r    350=2207800000000000000000000014D280
runtest .1
*Compare
r 400.8
*Want "QADTR 12345 q 1E-2" 22300000 0014D280
r 408.8
*Want "QADTR 1234500E-2 q 1E0" 22380000 000049C5
r 410.10
*Want "QAXTR 12345 q 1E-2" 22078000 00000000 00000000 0014D280
r 420.10
*Want "QAXTR 1234500E-2 q 1E0" 22080000 00000000 00000000 000049C5
*Done
