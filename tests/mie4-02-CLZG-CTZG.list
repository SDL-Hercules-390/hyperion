                                                   113 ***********************************************************************
                                                   114 * (pending     B968  CLZG  - COUNT LEADING ZEROS
                                                   115 *  inclusion in SATK ASAM)
                                                   116 *
                                                   117 *     CLZG Macro to help build CLZG instruction
                                                   118 *        CLZG
                                                   119 *
                                                   120 *        Note: R1, R2 are fixed registers:
                                                   121 *                         r1 = 1; r2 = 2
                                                   122 ***********************************************************************
                                                   123          MACRO
                                                   124          CLZG
                                                   125                                                                SPACE 1
                                                   126          DS    0H
                                                   127          DC    XL4'B9680012'           CLZQ r1,r2
                                                   128                                                                SPACE 1
                                                   129          MEND
                                                   130
                                                   131 ***********************************************************************
                                                   132 * (pending     B969  CTZG  - COUNT TRAILING ZEROS
                                                   133 *  inclusion in SATK ASAM)
                                                   134 *
                                                   135 *     CTZG Macro to help build CTZG instruction
                                                   136 *        CLZG
                                                   137 *
                                                   138 *        Note: R1, R2 are fixed registers:
                                                   139 *                         r1 = 1; r2 = 2
                                                   140 ***********************************************************************
                                                   141          MACRO
                                                   142          CTZG
                                                   143                                                                SPACE 1
                                                   144          DS    0H
                                                   145          DC    XL4'B9690012'           CTZQ r1,r2
                                                   146                                                                SPACE 1
                                                   147          MEND
