                                                   218 ***********************************************************************
                                                   219 * (pending LXA - load indexed address helper
                                                   220 *  inclusion in SATK ASAM)
                                                   221 *
                                                   222 *     LXA Macro to help build LLXA.. abs LXA.. instructions
                                                   223 *        LXA   &opcode,&x2,&b2,&dx2,&negd2
                                                   224 *
                                                   225 *        &opcode = last byte of lXA../LLXA.. instruction
                                                   226 *        &x2     = index register number 0-15
                                                   227 *        &b2     = base register number 0-15
                                                   228 *        &dx2    = 20-bit displacement (positive number)
                                                   229 *        &nexd2  = - if DX2 is negative
                                                   230 *
                                                   231 *        Note: R1 is a fixed register:
                                                   232 *                         r1 = 1;
                                                   233 ***********************************************************************
                                                   234          MACRO
                                                   235          LXA   &OPCODE,&X2,&B2,&D2,&NEGD2
                                                   236          LCLA  &DX2
                                                   237          LCLA  &R1X2
                                                   238          LCLA  &DXH2
                                                   239          LCLA  &DXL2
                                                   240          LCLA  &B2DXL2
                                                   241
                                                   242 .*        MNOTE *,'&&D2 == &D2'
                                                   243 .*      MNOTE *,'&&NEGD2 == &NEGD2'
                                                   244
                                                   245          AIF   ('&NEGD2' EQ  '-').NEGDX2
                                                   246 .*        MNOTE *,'Positive D2'
                                                   247 .*        MNOTE *,'-----------'
                                                   248
                                                   249 .* positive DX2
                                                   250 &DX2     SETA  &D2
                                                   251 &R1X2    SETA  +((1*16)+&X2)
                                                   252
                                                   253 &DXH2    SETA  +(&DX2/4096)
                                                   254 &DXL2    SETA  +(&DX2-(&DXH2*4096))
                                                   255 &B2DXL2  SETA  +((4096*&B2)+&DXL2)
                                                   256          AGO   .BUILD
                                                   257
                                                   258 .NEGDX2  ANOP
                                                   259 .*        MNOTE *,'Negative D2'
                                                   260 .*        MNOTE *,'-----------'
                                                   261
                                                   262 .* negative DX2
                                                   263 &DX2     SETA  &D2
                                                   264 &R1X2    SETA  +((1*16)+&X2)
                                                   265
                                                   266          AIF   (&DX2 LE  4095).NEG4095
                                                   267 .*       dx2 is -4096 to ...
                                                   268 &DXH2    SETA  +(0-(&DX2/4096))
                                                   269 &DXL2    SETA  (0-(&DX2-((&DX2/4096)*4096)))
                                                   270 &B2DXL2  SETA  +((4096*&B2)+&DXL2)
                                                   271 .*         MNOTE *,'>>>> &&DXH2 == &DXH2'
                                                   272 .*         MNOTE *,'>>>> &&DXL2 == &DXL2'
                                                   273
ASMA Ver. 0.7.0  mie4-03-IndexedAddress                                                             09 Mar 2026 12:33:21  Page    10

  LOC        OBJECT CODE       ADDR1     ADDR2    STMT

                                                   274          AGO   .BUILD
                                                   275 .*       dx2 is -1 to -4095
                                                   276 .NEG4095  ANOP
                                                   277 &DXH2    SETA  X'FF'
                                                   278 &DXL2    SETA  ((0-&DX2)-X'FFFFF000')  just the last 12 bits
                                                   279 &B2DXL2  SETA  +((4096*&B2)+&DXL2)
                                                   280 .*         MNOTE *,'>> &&DXH2 == &DXH2'
                                                   281 .*         MNOTE *,'>> &&DXL2 == &DXL2'
                                                   282
                                                   283 .BUILD   ANOP
                                                   284 .*         MNOTE *,'&&B2 == &B2'
                                                   285 .*         MNOTE *,'&&X2 == &X2'
                                                   286 .*         MNOTE *,'&&DX2 == &DX2'
                                                   287 .*         MNOTE *,'&&R1X22 == &R1X2'
                                                   288 .*         MNOTE *,'&&DXH2 == &DXH2'
                                                   289 .*         MNOTE *,'&&DXL2 == &DXL2'
                                                   290 .*         MNOTE *,'&&B2DXL2 == &B2DXL2'
                                                   291
                                                   292          DS    0H                      LLXA../LLXA.  r1,&dx2(&x2,&b2)
                                                   293          DC    XL1'E3'                 LLXA../LLXA.
                                                   294          DC    HL1'&R1X2'              r1, x2
                                                   295          DC    HL2'&B2DXL2'            b2, dxl2
                                                   296          DC    HL1'&DXH2'              dxh2
                                                   297          DC    XL1'&OPCODE'            LLXA../LLXA.. opcode
                                                   298
                                                   299          MEND
