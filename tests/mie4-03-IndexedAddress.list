                                                    73 ***********************************************************************
                                                    74 *        FCHECK Macro - Is a Facility Bit set?
                                                    75 *
                                                    76 *        If the facility bit is NOT set, an message is issued and
                                                    77 *        the test is skipped.
                                                    78 *
                                                    79 *        Fcheck uses R0, R1 and R2
                                                    80 *
                                                    81 * eg.    FCHECK 134,'vector-packed-decimal'
                                                    82 ***********************************************************************
                                                    83          MACRO
                                                    84          FCHECK &BITNO,&NOTSETMSG
                                                    85 .*                        &BITNO : facility bit number to check
                                                    86 .*                        &NOTSETMSG : 'facility name'
                                                    87          LCLA  &FBBYTE           Facility bit in Byte
                                                    88          LCLA  &FBBIT            Facility bit within Byte
                                                    89
                                                    90          LCLA  &L(8)
                                                    91 &L(1)    SetA  128,64,32,16,8,4,2,1  bit positions within byte
                                                    92
                                                    93 &FBBYTE  SETA  &BITNO/8
                                                    94 &FBBIT   SETA  &L((&BITNO-(&FBBYTE*8))+1)
                                                    95 .*       MNOTE 0,'checking Bit=&BITNO: FBBYTE=&FBBYTE, FBBIT=&FBBIT'
                                                    96
                                                    97          B     X&SYSNDX
                                                    98 *                                      Fcheck data area
                                                    99 *                                      skip messgae
                                                   100 SKT&SYSNDX DC  C'    Skipping tests: '
                                                   101          DC    C&NOTSETMSG
                                                   102          DC    C' (bit &BITNO) is not installed.'
                                                   103 SKL&SYSNDX EQU *-SKT&SYSNDX
                                                   104 *                                      facility bits
                                                   105          DS    FD                      gap
                                                   106 FB&SYSNDX DS   4FD
                                                   107          DS    FD                      gap
                                                   108 *
                                                   109 X&SYSNDX EQU *
                                                   110          LA    R0,((X&SYSNDX-FB&SYSNDX)/8)-1
                                                   111          STFLE FB&SYSNDX               get facility bits
                                                   112
                                                   113          XGR   R0,R0
                                                   114          IC    R0,FB&SYSNDX+&FBBYTE    get fbit byte
                                                   115          N     R0,=F'&FBBIT'           is bit set?
                                                   116          BNZ   XC&SYSNDX
                                                   117 *
                                                   118 * facility bit not set, issue message and exit
                                                   119 *
                                                   120          LA    R0,SKL&SYSNDX           message length
                                                   121          LA    R1,SKT&SYSNDX           message address
                                                   122          BAL   R2,MSG
                                                   123
                                                   124          B     EOJ
                                                   125 XC&SYSNDX EQU *
                                                   126          MEND
