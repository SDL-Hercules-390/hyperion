                                                   571 ***********************************************************************
                                                   572 *     Macros to help build test tables
                                                   573 *----------------------------------------------------------------------
                                                   574 *     VRR_I Macro to help build test tables
                                                   575 ***********************************************************************
                                                   576          MACRO
                                                   577          VRR_I &INST,&M3,&M4,&CC
                                                   578 .*                               &INST  - VRS-d instruction under test
                                                   579 .*                               &M3    - P2 (bit 0), P1 (bit 2) and
                                                   580 .*                                        CS (bit 3)
                                                   581 .*                               &CC    - expected CC
                                                   582 .*
                                                   583 .*                     note:     M4    - bit 0   IOM (always 0)
                                                   584 .*
                                                   585 .*
                                                   586          LCLA  &XCC(4)  &CC has mask values for FAILED condition codes
                                                   587 &XCC(1)  SETA  7                 CC != 0
                                                   588 &XCC(2)  SETA  11                CC != 1
                                                   589 &XCC(3)  SETA  13                CC != 2
                                                   590 &XCC(4)  SETA  14                CC != 3
                                                   591
                                                   592          GBLA  &TNUM
                                                   593 &TNUM    SETA  &TNUM+1
                                                   594
                                                   595          DS    0FD
                                                   596          USING *,R5              base for test data and test routine
                                                   597
                                                   598 T&TNUM   DC    A(X&TNUM)         address of test routine
                                                   599          DC    H'&TNUM'          test number
                                                   600          DC    XL1'00'
                                                   601          DC    HL1'&M3'          &M3
                                                   602          DC    HL1'&M4'          &M4
                                                   603          DC    HL1'&CC'          cc
                                                   604          DC    HL1'&XCC(&CC+1)'  cc failed mask
                                                   605
                                                   606          DC    CL8'&INST'        instruction name
                                                   607          DC    A(16)             result length
                                                   608 REA&TNUM DC    A(RE&TNUM)        result address
                                                   609          DS    FD                      gap
                                                   610 R1O&TNUM DS    FD                R1 OUTPUT
                                                   611          DS    FD                      gap
                                                   612 .*
                                                   613 *                                INSTRUCTION UNDER TEST ROUTINE
                                                   614 X&TNUM   DS    0F
                                                   615          LG    R1,R1FUDGE        pollute R1
                                                   616          VL    V1,RE&TNUM+8      get V1 source
                                                   617
                                                   618          &INST R1,V1,&M3,&M4     test instruction
                                                   619
                                                   620          STG   R1,R1O&TNUM       save
                                                   621          EPSW  R2,R0             exptract psw
                                                   622          ST    R2,CCPSW              to save CC
                                                   623
                                                   624          BR    R11               return
                                                   625
                                                   626 RE&TNUM  DC    0F
