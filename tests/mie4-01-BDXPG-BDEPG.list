                                                   114 ***********************************************************************
                                                   115 * (pending     B96C  BEXTG - Bit Extract
                                                   116 *  inclusion in SATK ASAM)
                                                   117 *
                                                   118 *     BEXTG Macro to help build BEXTG instruction
                                                   119 *        BEXTG
                                                   120 *
                                                   121 *        Note: R1, R2 are fixed registers:
                                                   122 *                         r1 = 1; r2 = 2; R3 = 3
                                                   123 ***********************************************************************
                                                   124          MACRO
                                                   125        BEXTG
                                                   126                                                                SPACE 1
                                                   127          DS    0H
                                                   128          DC    XL4'B96C3012'           BEXTG r1,r2,R3
                                                   129                                                                SPACE 1
                                                   130          MEND
                                                   131
                                                   132 ***********************************************************************
                                                   133 * (pending     B96D  BDEPG - Bit Deposit
                                                   134 *  inclusion in SATK ASAM)
                                                   135 *
                                                   136 *     BDEPG Macro to help build BDEPG instruction
                                                   137 *        BDEPG
                                                   138 *
                                                   139 *        Note: R1, R2 are fixed registers:
                                                   140 *                         r1 = 1; r2 = 2; R3 = 3
                                                   141 ***********************************************************************
                                                   142          MACRO
                                                   143          BDEPG
                                                   144                                                                SPACE 1
                                                   145          DS    0H
                                                   146          DC    XL4'B96D3012'           BDEPG r1,r2,R3
                                                   147                                                                SPACE 1
                                                   148          MEND
